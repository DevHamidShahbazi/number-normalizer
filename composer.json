{
  "name": "devhamidshahbazi/number-normalizer",
  "description": "Laravel package to automatically normalize any non-English digits (Persian, Arabic, Urdu, etc.) to English numbers in all requests",
  "type": "laravel-package",
  "license": "MIT",
  "authors": [
    {
      "name": "Hamid Shahbazi",
      "email": "dev.hamidshahbazi@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^9.0|^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "NumberNormalizer\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "NumberNormalizer\\Providers\\NumberNormalizerServiceProvider"
      ],
      "aliases": {
        "NumberNormalizer": "NumberNormalizer\\Facades\\NumberNormalizer"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
